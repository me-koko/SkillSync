datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillType {
  TEACH
  LEARN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum ExchangeStatus {
  PROPOSED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum GroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  NEW_MESSAGE
  GROUP_INVITE
  GROUP_ACTIVITY
  TASK_ASSIGNED
  TASK_DUE
  ROOM_INVITE
  EXCHANGE_PROPOSAL
  EXCHANGE_ACCEPTED
  EXCHANGE_COMPLETED
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  passwordHash    String
  fullName        String
  avatarUrl       String?
  college         String
  course          String
  yearOfStudy     String           // e.g. "1st Year", "2nd Year", "3rd Year", "4th Year", "Graduate"
  bio             String?
  headline        String?
  learningFormat  String?          // "One-on-one", "Small group", "Large group"
  learningStyle   String?          // "Structured", "Casual"
  privacySetting  String           @default("PUBLIC") // PUBLIC, CONNECTIONS_ONLY, PRIVATE
  isOnboarded     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  skills          UserSkill[]
  interests       UserInterest[]
  availabilities  Availability[]
  
  sentConnections     Connection[]     @relation("SentConnections")
  receivedConnections Connection[]     @relation("ReceivedConnections")
  
  initiatedExchanges  SkillExchange[]  @relation("InitiatedExchanges")
  receivedExchanges   SkillExchange[]  @relation("ReceivedExchanges")
  
  groupMemberships    GroupMember[]
  createdGroups       StudyGroup[]     @relation("CreatedGroups")
  
  roomMemberships     RoomMember[]
  createdRooms        StudyRoom[]      @relation("CreatedRooms")
  
  createdTasks        Task[]           @relation("CreatedTasks")
  assignedTasks       Task[]           @relation("AssignedTasks")
  
  sentMessages        Message[]        @relation("SentMessages")
  notifications       Notification[]   @relation("UserNotifications")
  
  givenReviews        Review[]         @relation("GivenReviews")
  receivedReviews     Review[]         @relation("ReceivedReviews")
  uploadedResources   Resource[]       @relation("UploadedResources")
}

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String      // e.g., "Programming", "Design", "Language", "Academics", "Music", "Soft Skills"
  userSkills  UserSkill[]
}

model UserSkill {
  id        String      @id @default(uuid())
  userId    String
  skillId   String
  type      SkillType   // TEACH or LEARN
  level     SkillLevel  // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId, type])
}

model Interest {
  id            String         @id @default(uuid())
  name          String         @unique
  category      String?
  userInterests UserInterest[]
}

model UserInterest {
  id         String   @id @default(uuid())
  userId     String
  interestId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@unique([userId, interestId])
}

model Availability {
  id         String   @id @default(uuid())
  userId     String
  dayOfWeek  String   // "Monday", "Tuesday", "Wednesday", etc.
  timeSlot   String   // "Morning", "Afternoon", "Evening", "Night"
  preference String   @default("ONLINE") // "ONLINE", "IN_PERSON", "BOTH"
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Connection {
  id          String           @id @default(uuid())
  senderId    String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sender      User             @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model SkillExchange {
  id            String         @id @default(uuid())
  initiatorId   String
  partnerId     String
  teachSkill    String         // Skill initiator teaches
  learnSkill    String         // Skill initiator learns
  schedule      String         // e.g. "Saturdays 5-6 PM"
  format        String         @default("Online") // "Online" or "In-person"
  status        ExchangeStatus @default(PROPOSED)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  initiator     User           @relation("InitiatedExchanges", fields: [initiatorId], references: [id], onDelete: Cascade)
  partner       User           @relation("ReceivedExchanges", fields: [partnerId], references: [id], onDelete: Cascade)
  reviews       Review[]
}

model StudyGroup {
  id          String        @id @default(uuid())
  name        String
  description String
  topic       String
  creatorId   String
  isPrivate   Boolean       @default(false)
  avatarUrl   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  creator     User          @relation("CreatedGroups", fields: [creatorId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  tasks       Task[]
  resources   Resource[]
  messages    Message[]
}

model GroupMember {
  id        String     @id @default(uuid())
  groupId   String
  userId    String
  role      GroupRole  @default(MEMBER)
  joinedAt  DateTime   @default(now())
  group     StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model StudyRoom {
  id          String       @id @default(uuid())
  name        String
  topic       String
  creatorId   String
  isPrivate   Boolean      @default(false)
  activeTimer Int          @default(1500) // in seconds (25 min Pomodoro)
  isTimerOn   Boolean      @default(false)
  sharedNotes String       @default("")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creator     User         @relation("CreatedRooms", fields: [creatorId], references: [id], onDelete: Cascade)
  members     RoomMember[]
  tasks       Task[]
  messages    Message[]
  resources   Resource[]
}

model RoomMember {
  id       String    @id @default(uuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  room     StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  creatorId   String
  assigneeId  String?
  groupId     String?
  roomId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  creator     User         @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: Cascade)
  assignee    User?        @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  group       StudyGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room        StudyRoom?   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Message {
  id          String      @id @default(uuid())
  senderId    String
  receiverId  String?     // For 1-on-1 direct message
  groupId     String?     // For study group chat
  roomId      String?     // For study room chat
  content     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  sender      User        @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  group       StudyGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room        StudyRoom?  @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
}

model Resource {
  id         String      @id @default(uuid())
  name       String
  type       String      // "link", "pdf", "image", "document"
  url        String
  size       Int?
  uploaderId String
  groupId    String?
  roomId     String?
  createdAt  DateTime    @default(now())
  uploader   User        @relation("UploadedResources", fields: [uploaderId], references: [id], onDelete: Cascade)
  group      StudyGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  room       StudyRoom?  @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Review {
  id          String         @id @default(uuid())
  exchangeId  String?
  reviewerId  String
  revieweeId  String
  rating      Int            // 1 to 5 stars
  feedback    String
  createdAt   DateTime       @default(now())
  exchange    SkillExchange? @relation(fields: [exchangeId], references: [id], onDelete: SetNull)
  reviewer    User           @relation("GivenReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee    User           @relation("ReceivedReviews", fields: [revieweeId], references: [id], onDelete: Cascade)
}
